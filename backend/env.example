# Copy this file to .env and fill in your real values
# Get this from Supabase: Project Settings -> Database -> Connection String
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# Keep the same private random signing secret across restarts and every worker.
# Production requires it; changing it invalidates existing logins and console OTPs.
SECRET_KEY=change-this-to-a-long-random-string

# Supported shared-secret algorithms: HS256 (default), HS384, HS512.
ALGORITHM=HS256
# Positive integer; default is 1440 minutes (24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Signup OTP: off permits demo signup with unverified numbers and no SMS.
# console prints local test codes; twilio sends real SMS.
# For a deployed demo, set SIGNUP_OTP_MODE=off and APP_ENV=production.
# Keep these credentials on the backend only.
SIGNUP_OTP_MODE=console
APP_ENV=development
# Set APP_ENV=production in the deployed environment before startup.
# Production ignores local .env files. Render always requires a configured secret,
# even if APP_ENV is accidentally set to development. Test mode also requires one.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# AI menu photos (server-side only; never put this key in frontend)

# Registration email (Gmail SMTP with an app password; server-side only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Must be reachable from the customer's device; localhost works only on this PC.
CUSTOMER_LOGIN_URL=

# Cloudflare Workers AI menu photos (backend only)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
MENU_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
